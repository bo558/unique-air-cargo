---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { site } from '@/data/site';
import type { Locale } from '@/i18n/config';
import heroImage from '@/assets/images/wing-clouds.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { address } = site.contact;
const fullAddress = `${address.street}, ${address.postalCode} ${address.district} / ${address.city}`;

const copy = {
  en: {
    title: 'Privacy Notice',
    description:
      'How Unique Air Cargo processes personal data under the Turkish Personal Data Protection Law No. 6698 (KVKK).',
    eyebrow: 'Legal information',
  },
  tr: {
    title: 'KVKK Aydınlatma Metni',
    description: 'Unique Air Cargo kişisel verilerin korunması ve işlenmesine ilişkin 6698 sayılı KVKK kapsamında aydınlatma metni.',
    eyebrow: 'Yasal bilgilendirme',
  },
}[locale];
---

<BaseLayout title={copy.title} description={copy.description}>
  <PageHero
    eyebrow={copy.eyebrow}
    title={copy.title}
    image={heroImage}
    imageAlt=""
    crumbs={[{ label: copy.title }]}
    size="compact"
  />

  <section class="section">
    <div class="container container--narrow">
      {
        locale === 'en' && (
          <article class="legal prose">
            <p class="legal__intro">
              As data controller under the Turkish Personal Data Protection Law No. 6698 (“KVKK”), {site.legalName} (“the
              Company”) would like to inform you about the purposes for which your personal data is processed, to whom it
              may be transferred, how it is collected, the legal basis for processing and your rights.
            </p>

            <h2>1. Data controller</h2>
            <p>
              <strong>{site.legalName}</strong>
              <br />
              {fullAddress}, Türkiye
              <br />
              Email: <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
            </p>

            <h2>2. Personal data we process</h2>
            <p>
              We process the information you share with us through the quote and contact forms on this website, by email
              or by phone: your full name, company or organisation, email address, phone number and the operational
              details of your request (origin and destination, dates, cargo or passenger details).
            </p>

            <h2>3. Purposes of processing</h2>
            <ul>
              <li>Assessing and responding to your quote and information requests;</li>
              <li>Planning charter services and carrying out contractual processes;</li>
              <li>Coordinating operations with the relevant parties;</li>
              <li>Fulfilling legal obligations and providing information to competent authorities.</li>
            </ul>

            <h2>4. Legal basis and method of collection</h2>
            <p>
              Your personal data is collected electronically through the forms on our website, by email and by phone. It
              is processed on the legal grounds set out in Article 5 of the KVKK: processing being directly related to the
              conclusion or performance of a contract, compliance with the Company’s legal obligations, and the Company’s
              legitimate interests, provided this does not harm your fundamental rights and freedoms.
            </p>

            <h2>5. Transfers</h2>
            <p>
              Your personal data may be shared, only to the extent your request requires, with air carriers, ground
              handling providers, our business partners in Türkiye and abroad, and competent public authorities, within
              the conditions set out in Articles 8 and 9 of the KVKK. Given the international nature of charter
              operations, data may be transferred abroad.
            </p>

            <h2>6. Your rights</h2>
            <p>Under Article 11 of the KVKK, as a data subject you have the right to:</p>
            <ul>
              <li>learn whether your personal data is processed;</li>
              <li>request information if it has been processed;</li>
              <li>learn the purpose of processing and whether it is used accordingly;</li>
              <li>know the third parties in Türkiye or abroad to whom it is transferred;</li>
              <li>request correction if it is incomplete or inaccurate;</li>
              <li>request deletion or destruction under the conditions set out in the KVKK;</li>
              <li>request that third parties to whom data was transferred be notified of such correction, deletion or destruction;</li>
              <li>object to any adverse outcome arising exclusively from automated analysis of your data;</li>
              <li>claim compensation for damages arising from unlawful processing.</li>
            </ul>

            <h2>7. How to apply</h2>
            <p>
              You can submit requests regarding your rights, together with information verifying your identity, by email
              to <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a> or in writing to {fullAddress},
              Türkiye. Requests will be concluded within thirty days at the latest, depending on their nature.
            </p>
          </article>
        )
      }
      {
        locale === 'tr' && (
      <article class="legal prose">
        <p class="legal__intro">
          {site.legalName} (“Şirket”) olarak, 6698 sayılı Kişisel Verilerin Korunması Kanunu (“KVKK”) uyarınca veri
          sorumlusu sıfatıyla, kişisel verilerinizin hangi amaçlarla işlendiği, kimlere aktarılabileceği, toplanma
          yöntemi, hukuki sebebi ve haklarınız konusunda sizi bilgilendirmek isteriz.
        </p>

        <h2>1. Veri sorumlusu</h2>
        <p>
          <strong>{site.legalName}</strong><br />
          {fullAddress}<br />
          E-posta: <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </p>

        <h2>2. İşlenen kişisel veriler</h2>
        <p>
          İnternet sitemizdeki teklif ve iletişim formları ile e-posta ve telefon yoluyla bizimle paylaştığınız; ad
          soyad, şirket/kurum bilgisi, e-posta adresi, telefon numarası ve talebinize ilişkin operasyon bilgileri
          (kalkış ve varış noktası, tarih, yük veya yolcu detayları) işlenmektedir.
        </p>

        <h2>3. İşleme amaçları</h2>
        <ul>
          <li>Teklif ve bilgi taleplerinizin değerlendirilmesi ve yanıtlanması,</li>
          <li>Charter hizmetlerinin planlanması, sözleşme süreçlerinin yürütülmesi,</li>
          <li>Operasyonların ilgili taraflarla koordinasyonunun sağlanması,</li>
          <li>Yasal yükümlülüklerin yerine getirilmesi ve yetkili mercilere bilgi verilmesi.</li>
        </ul>

        <h2>4. Hukuki sebep ve toplama yöntemi</h2>
        <p>
          Kişisel verileriniz; internet sitemizdeki formlar, e-posta ve telefon kanallarıyla elektronik ortamda
          toplanmakta olup KVKK’nın 5. maddesinde yer alan “bir sözleşmenin kurulması veya ifasıyla doğrudan doğruya
          ilgili olması”, “veri sorumlusunun hukuki yükümlülüğünü yerine getirebilmesi” ve “ilgili kişinin temel hak ve
          özgürlüklerine zarar vermemek kaydıyla veri sorumlusunun meşru menfaati” hukuki sebeplerine dayanılarak
          işlenmektedir.
        </p>

        <h2>5. Aktarım</h2>
        <p>
          Kişisel verileriniz, yalnızca talebinizin gerektirdiği ölçüde; hava taşıma operatörleri, yer hizmetleri
          kuruluşları, yurt içi ve yurt dışındaki iş ortaklarımız ve yetkili kamu kurum ve kuruluşları ile KVKK’nın
          8. ve 9. maddelerinde belirtilen şartlar çerçevesinde paylaşılabilir. Charter operasyonlarının uluslararası
          niteliği gereği, verilerin yurt dışına aktarımı söz konusu olabilir.
        </p>

        <h2>6. Haklarınız</h2>
        <p>KVKK’nın 11. maddesi uyarınca veri sahibi olarak;</p>
        <ul>
          <li>Kişisel verilerinizin işlenip işlenmediğini öğrenme,</li>
          <li>İşlenmişse buna ilişkin bilgi talep etme,</li>
          <li>İşlenme amacını ve amacına uygun kullanılıp kullanılmadığını öğrenme,</li>
          <li>Yurt içinde veya yurt dışında aktarıldığı üçüncü kişileri bilme,</li>
          <li>Eksik veya yanlış işlenmişse düzeltilmesini isteme,</li>
          <li>KVKK’da öngörülen şartlar çerçevesinde silinmesini veya yok edilmesini isteme,</li>
          <li>Düzeltme, silme ve yok etme işlemlerinin aktarıldığı üçüncü kişilere bildirilmesini isteme,</li>
          <li>Münhasıran otomatik sistemlerle analiz edilmesi sonucu aleyhinize bir sonucun ortaya çıkmasına itiraz etme,</li>
          <li>Kanuna aykırı işleme sebebiyle zarara uğramanız hâlinde zararın giderilmesini talep etme</li>
        </ul>
        <p>haklarına sahipsiniz.</p>

        <h2>7. Başvuru</h2>
        <p>
          Haklarınıza ilişkin taleplerinizi, kimliğinizi tespit edici bilgilerle birlikte
          <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a> adresine e-posta yoluyla veya
          {fullAddress} adresine yazılı olarak iletebilirsiniz. Talepleriniz, niteliğine göre en geç otuz gün içinde
          sonuçlandırılacaktır.
        </p>
      </article>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .legal__intro {
    font-size: var(--fs-lead);
    line-height: 1.65;
  }

  .legal h2 {
    margin: 3rem 0 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-h4);
    letter-spacing: -0.01em;
  }

  .legal ul {
    margin: 1rem 0;
    padding-left: 1.25rem;
    color: var(--text-2);
  }

  .legal li + li {
    margin-top: 0.4rem;
  }

  .legal li::marker {
    color: var(--brand);
  }

  .legal a {
    color: var(--brand-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>
