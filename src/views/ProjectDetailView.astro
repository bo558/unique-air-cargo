---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import RouteMap from '@/components/RouteMap.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { getProjects, type LocalizedProject } from '@/data/projects';
import { getService } from '@/data/services';
import { pathTo, quoteHash, type Locale } from '@/i18n/config';
import { withBase } from '@/utils/paths';
import { t } from '@/i18n/ui';

interface Props {
  locale: Locale;
  project: LocalizedProject;
}

const { locale, project } = Astro.props;
const ui = t(locale);
const service = getService(locale, project.service);
const all = getProjects(locale);
const idx = all.findIndex((p) => p.id === project.id);
const prev = all[(idx - 1 + all.length) % all.length];
const next = all[(idx + 1) % all.length];
const more = [1, 2, 3].map((k) => all[(idx + k) % all.length]);

const gallery = project.images.slice(1);
// Large versions for the lightbox
const large = await Promise.all(project.images.map((img) => getImage({ src: img, width: 1800, format: 'webp', quality: 80 })));
const hasMap = Boolean(project.from || project.to);
const quoteHref = pathTo(locale, 'contact', `?service=${project.service}${quoteHash[locale]}`);

const copy = {
  en: {
    eyebrow: 'Project',
    lead: project.note ?? `${project.cargo}${project.route ? ` · ${project.route}` : ''}.`,
    galleryTitle: 'On the apron,',
    galleryAccent: 'in the hold.',
    close: 'Close',
    open: 'Open photo',
    ctaTitle: 'Planning a similar',
    ctaAccent: 'operation?',
    ctaText: 'Share your cargo, route and timing — we will come back with suitable aircraft options and a clear quote.',
    moreTitle: 'More',
    moreAccent: 'projects.',
  },
  tr: {
    eyebrow: 'Proje',
    lead: project.note ?? `${project.cargo}${project.route ? ` · ${project.route}` : ''}.`,
    galleryTitle: 'Apronda,',
    galleryAccent: 'ambarda.',
    close: 'Kapat',
    open: 'Fotoğrafı aç',
    ctaTitle: 'Benzer bir operasyon',
    ctaAccent: 'mu planlıyorsunuz?',
    ctaText: 'Yükünüzü, rotanızı ve zamanlamanızı paylaşın; uygun uçak seçeneklerini ve net bir teklifi iletelim.',
    moreTitle: 'Diğer',
    moreAccent: 'projeler.',
  },
}[locale];
---

<BaseLayout title={project.title} description={copy.lead} image={project.cover}>
  <PageHero
    eyebrow={project.tag}
    title={project.title}
    lead={copy.lead}
    image={project.cover}
    imageAlt={project.title}
    crumbs={[{ label: ui.nav.projects, href: pathTo(locale, 'projects') }, { label: project.title }]}
  >
    <a href={quoteHref} class="btn btn--light">{ui.nav.requestQuote} <Icon name="arrow-right" /></a>
    <a href={pathTo(locale, 'projects')} class="btn btn--ghost-light">{ui.project.all}</a>
  </PageHero>

  <!-- Facts + route -->
  <section class:list={['section', 'section--sm', 'pd-facts', hasMap && 'surface-ink']} aria-label={ui.project.route}>
    <div class:list={['container', 'pd-facts__grid', !hasMap && 'pd-facts__grid--solo']}>
      <dl class="pd-facts__list">
        {
          project.route && (
            <div>
              <dt>{ui.project.route}</dt>
              <dd>{project.route}</dd>
            </div>
          )
        }
        <div>
          <dt>{ui.project.cargo}</dt>
          <dd>{project.cargo}</dd>
        </div>
        {
          service && (
            <div>
              <dt>{ui.project.service}</dt>
              <dd>
                <a href={service.href} class="link-arrow">
                  {service.navTitle} <Icon name="arrow-right" />
                </a>
              </dd>
            </div>
          )
        }
      </dl>
      {hasMap && <RouteMap title={project.route ?? project.title} routes={[{ from: project.from, to: project.to }]} zoom class="pd-facts__map" />}
    </div>
  </section>

  <!-- Gallery -->
  {
    gallery.length > 0 && (
      <section class="section" aria-labelledby="gallery-title">
        <div class="container">
          <SectionHeader id="gallery-title" eyebrow={ui.project.gallery} title={copy.galleryTitle} accent={copy.galleryAccent} />
          <ul class:list={['pd-gallery', `pd-gallery--${Math.min(gallery.length, 5)}`]} role="list" data-gallery>
            {gallery.map((img, i) => (
              <li data-reveal style={`--reveal-delay:${(i % 3) * 70}`}>
                <button type="button" class="pd-gallery__btn" data-full={large[i + 1].src} aria-label={`${copy.open} ${i + 2}`}>
                  <Image
                    src={img}
                    alt={`${project.title} — ${i + 2}`}
                    widths={[480, 800, 1200]}
                    sizes="(min-width: 1100px) 50vw, 92vw"
                    loading="lazy"
                  />
                </button>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Video -->
  {
    project.video && (
      <section class="section section--flush-top" aria-label={ui.project.video}>
        <div class="container">
          <figure class="pd-video" data-reveal>
            <video
              src={withBase(`/${project.video.src}`)}
              poster={project.video.poster ? (await getImage({ src: project.video.poster, width: 1280, format: 'webp' })).src : undefined}
              controls
              muted
              playsinline
              preload="none"
            />
            <figcaption class="caption">{ui.project.video}</figcaption>
          </figure>
        </div>
      </section>
    )
  }

  <!-- Prev / next -->
  <nav class="pd-nav" aria-label={ui.project.all}>
    <div class="container pd-nav__inner">
      <a href={prev.href} class="pd-nav__link">
        <span class="pd-nav__label"><Icon name="arrow-right" class="pd-nav__back" /> {ui.project.prev}</span>
        <span class="pd-nav__title">{prev.title}</span>
      </a>
      <a href={next.href} class="pd-nav__link pd-nav__link--next">
        <span class="pd-nav__label">{ui.project.next} <Icon name="arrow-right" /></span>
        <span class="pd-nav__title">{next.title}</span>
      </a>
    </div>
  </nav>

  <section class="section surface-white" aria-labelledby="more-title">
    <div class="container">
      <SectionHeader id="more-title" eyebrow={ui.nav.projects} title={copy.moreTitle} accent={copy.moreAccent} layout="split">
        <a href={pathTo(locale, 'projects')} class="link-arrow">{ui.project.all} <Icon name="arrow-right" /></a>
      </SectionHeader>
      <div class="pd-more">
        {more.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow={service?.navTitle ?? copy.eyebrow}
    title={copy.ctaTitle}
    accent={copy.ctaAccent}
    text={copy.ctaText}
    image={project.images[1] ?? project.cover}
    primaryHref={quoteHref}
  />

  <dialog class="lightbox" data-lightbox aria-label={ui.project.gallery}>
    <img alt="" data-lightbox-img />
    <button type="button" class="lightbox__close" data-lightbox-close aria-label={copy.close}><Icon name="close" size={22} /></button>
  </dialog>
</BaseLayout>

<style>
  /* Facts */
  .pd-facts__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
    gap: 2.5rem clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }

  .pd-facts__grid--solo {
    grid-template-columns: 1fr;
  }

  .pd-facts__grid--solo .pd-facts__list {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 2rem;
  }

  .pd-facts__list {
    display: grid;
  }

  .pd-facts__list > div {
    padding: 1.15rem 0;
    border-top: 1px solid var(--line);
  }

  :global(.surface-ink) .pd-facts__list > div {
    border-color: var(--line-inv-strong);
  }

  .pd-facts__list dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  :global(.surface-ink) .pd-facts__list dt {
    color: var(--text-inv-3);
  }

  .pd-facts__list dd {
    margin-top: 0.35rem;
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 1.05rem + 0.4vw, 1.4rem);
    line-height: 1.3;
  }

  .pd-facts__list dd .link-arrow {
    font-family: var(--font-sans);
    font-size: 1rem;
  }

  /* Gallery: editorial rhythm — one wide frame, then pairs */
  .pd-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .pd-gallery li:first-child {
    grid-column: 1 / -1;
  }

  .pd-gallery li:first-child .pd-gallery__btn {
    aspect-ratio: 21 / 10;
  }

  .pd-gallery--2 li:first-child,
  .pd-gallery--4 li:first-child {
    grid-column: auto;
  }

  .pd-gallery--2 li:first-child .pd-gallery__btn,
  .pd-gallery--4 li:first-child .pd-gallery__btn {
    aspect-ratio: 4 / 3;
  }

  .pd-gallery--1 {
    grid-template-columns: 1fr;
  }

  .pd-gallery--4 li:last-child {
    grid-column: 1 / -1;
  }

  .pd-gallery--4 li:last-child .pd-gallery__btn {
    aspect-ratio: 21 / 10;
  }

  .pd-gallery__btn {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--ink-800);
    cursor: zoom-in;
  }

  .pd-gallery__btn :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease-out);
  }

  .pd-gallery__btn:hover :global(img) {
    transform: scale(1.03);
  }

  /* Video */
  .pd-video video {
    width: 100%;
    max-height: 78vh;
    background: var(--ink-950);
    aspect-ratio: 16 / 9;
    object-fit: contain;
  }

  /* Prev / next */
  .pd-nav {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .pd-nav__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .pd-nav__link {
    display: grid;
    gap: 0.45rem;
    padding: 1.75rem 2rem 1.75rem 0;
    transition: color 0.3s;
  }

  .pd-nav__link--next {
    padding: 1.75rem 0 1.75rem 2rem;
    border-left: 1px solid var(--line);
    text-align: right;
    justify-items: end;
  }

  .pd-nav__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-600);
  }

  .pd-nav__label :global(.pd-nav__back) {
    transform: rotate(180deg);
  }

  .pd-nav__title {
    font-family: var(--font-serif);
    font-size: var(--fs-h4);
    line-height: 1.25;
  }

  .pd-nav__link:hover .pd-nav__title {
    color: var(--brand-600);
  }

  .pd-more {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  /* Lightbox */
  .lightbox {
    width: min(96vw, 1600px);
    max-height: 94vh;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }

  .lightbox::backdrop {
    background: rgba(5, 9, 15, 0.92);
  }

  .lightbox img {
    width: 100%;
    max-height: 90vh;
    object-fit: contain;
  }

  .lightbox__close {
    position: absolute;
    top: -3rem;
    right: 0;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--white);
    color: var(--ink-900);
  }

  @media (max-width: 899px) {
    .pd-facts__grid {
      grid-template-columns: 1fr;
    }

    .pd-more {
      grid-template-columns: 1fr 1fr;
    }

    .pd-more > :global(:nth-child(3)) {
      display: none;
    }
  }

  @media (max-width: 639px) {
    .pd-facts__grid--solo .pd-facts__list {
      grid-template-columns: 1fr;
    }

    .pd-gallery {
      grid-template-columns: 1fr;
    }

    .pd-gallery li:first-child .pd-gallery__btn,
    .pd-gallery--4 li:last-child .pd-gallery__btn {
      aspect-ratio: 4 / 3;
    }

    .pd-nav__inner {
      grid-template-columns: 1fr;
    }

    .pd-nav__link,
    .pd-nav__link--next {
      padding: 1.25rem 0;
    }

    .pd-nav__link--next {
      border-left: 0;
      border-top: 1px solid var(--line);
    }

    .pd-more {
      grid-template-columns: 1fr;
    }

    .pd-more > :global(:nth-child(3)) {
      display: block;
    }
  }
</style>

<script>
  const box = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const img = box?.querySelector<HTMLImageElement>('[data-lightbox-img]');
  if (box && img) {
    document.querySelectorAll<HTMLButtonElement>('[data-gallery] [data-full]').forEach((btn) => {
      btn.addEventListener('click', () => {
        img.src = btn.dataset.full ?? '';
        img.alt = btn.querySelector('img')?.alt ?? '';
        box.showModal();
      });
    });
    box.querySelector('[data-lightbox-close]')?.addEventListener('click', () => box.close());
    box.addEventListener('click', (e) => {
      if (e.target === box) box.close();
    });
  }
</script>
