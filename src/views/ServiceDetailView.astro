---
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { getCategories, getDefaultProcess, getService, type LocalizedService } from '@/data/services';
import { site } from '@/data/site';
import { pathTo, quoteHash, type Locale } from '@/i18n/config';
import { t } from '@/i18n/ui';

interface Props {
  locale: Locale;
  service: LocalizedService;
}

const { locale, service } = Astro.props;
const ui = t(locale);
const related = service.related
  .map((id) => getService(locale, id))
  .filter((s): s is LocalizedService => Boolean(s));
const steps = service.process ?? getDefaultProcess(locale);
const quoteHref = pathTo(locale, 'contact', `?service=${service.id}${quoteHash[locale]}`);

const copy = {
  en: {
    callUs: 'Call Us',
    tocLabel: 'On this page',
    sections: { overview: 'Overview', uses: 'Applications', advantages: 'Advantages', process: 'Process', capabilities: 'Capabilities' },
    ids: { overview: 'overview', uses: 'applications', advantages: 'advantages', process: 'process', capabilities: 'capabilities' },
    usesEyebrow: 'Who · when',
    advTitle: 'What makes the difference',
    advAccent: 'in this operation.',
    advLead: 'Every detail is planned so the operation runs safely, on time and predictably.',
    processTitle: 'Step by step,',
    processAccent: 'a transparent plan.',
    processLead: 'From the moment we receive your request until delivery, you know what happens and when.',
    capEyebrow: 'Operational capabilities',
    capTitle: 'What our scope',
    capAccent: 'covers.',
    capLead: 'Each operation is planned by combining the following components as required.',
    relatedEyebrow: 'Related solutions',
    relatedTitle: 'You may also',
    relatedAccent: 'be interested in.',
    ctaTitle: 'Let’s plan this',
    ctaAccent: 'operation together.',
    serviceType: 'Charter flight',
  },
  tr: {
    callUs: 'Bizi Arayın',
    tocLabel: 'Bu sayfada',
    sections: { overview: 'Genel bakış', uses: 'Kullanım alanları', advantages: 'Avantajlar', process: 'Operasyon süreci', capabilities: 'Kabiliyetler' },
    ids: { overview: 'genel-bakis', uses: 'kullanim', advantages: 'avantajlar', process: 'surec', capabilities: 'kabiliyetler' },
    usesEyebrow: 'Kimler · hangi durumlar',
    advTitle: 'Bu operasyonda',
    advAccent: 'farkı yaratan.',
    advLead: 'Her detay, operasyonun güvenli, zamanında ve öngörülebilir ilerlemesi için planlanır.',
    processTitle: 'Adım adım,',
    processAccent: 'şeffaf bir plan.',
    processLead: 'Talebinizi aldığımız andan teslimata kadar her aşamada neyin, ne zaman yapılacağını bilirsiniz.',
    capEyebrow: 'Operasyonel kabiliyetler',
    capTitle: 'Kapsamımızda',
    capAccent: 'neler var?',
    capLead: 'Her operasyon, ihtiyaca göre aşağıdaki bileşenlerin bir araya getirilmesiyle planlanır.',
    relatedEyebrow: 'İlgili çözümler',
    relatedTitle: 'Bunlar da',
    relatedAccent: 'ilginizi çekebilir.',
    ctaTitle: 'Bu operasyonu',
    ctaAccent: 'birlikte planlayalım.',
    serviceType: 'Charter uçuş',
  },
}[locale];

const toc = (['overview', 'uses', 'advantages', 'process', 'capabilities'] as const).map((k) => ({
  id: copy.ids[k],
  label: copy.sections[k],
}));

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.title,
  serviceType: copy.serviceType,
  description: service.seo.description,
  url: new URL(service.href, Astro.site).href,
  provider: { '@id': `${site.url}/#organization` },
  areaServed: 'Worldwide',
};
---

<BaseLayout title={service.seo.title} description={service.seo.description} image={service.image} jsonLd={serviceSchema}>
  <PageHero
    eyebrow={service.hero.eyebrow}
    title={service.hero.title}
    accent={service.hero.accent}
    lead={service.hero.lead}
    image={service.image}
    imageAlt={service.imageAlt}
    crumbs={[{ label: ui.nav.services, href: pathTo(locale, 'services') }, { label: service.title }]}
  >
    <a href={quoteHref} class="btn btn--light">{ui.nav.requestQuote} <Icon name="arrow-right" /></a>
    <a href={site.contact.phoneHref} class="btn btn--ghost-light"><Icon name="phone" /> {copy.callUs}</a>
    <nav slot="meta" class="toc" aria-label={copy.tocLabel}>
      <p class="toc__label">{getCategories(locale)[service.category].label}</p>
      <ol role="list">
        {
          toc.map((item, i) => (
            <li>
              <a href={`#${item.id}`}>
                <span>0{i + 1}</span>
                {item.label}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </PageHero>

  <!-- Overview -->
  <section class="section overview" id={copy.ids.overview} aria-labelledby="overview-title">
    <div class="container">
      <div class="overview__grid">
        <div class="overview__head" data-reveal>
          <p class="eyebrow">{copy.sections.overview}</p>
          <h2 class="h2" id="overview-title">{service.intro.heading}</h2>
        </div>
        <div class="overview__body prose" data-reveal style="--reveal-delay:100">
          {service.intro.paragraphs.map((p) => <p class="overview__p">{p}</p>)}
          {
            service.intro.quote && (
              <blockquote class="overview__quote">
                <p>{service.intro.quote}</p>
              </blockquote>
            )
          }
        </div>
      </div>

      <figure class="overview__figure">
        <div class="overview__media" data-reveal-mask>
          <Image
            src={service.detailImage}
            alt={service.detailImageAlt}
            widths={[640, 960, 1440, 2000]}
            sizes="(min-width: 1400px) 1360px, 94vw"
            loading="lazy"
          />
        </div>
      </figure>
    </div>
  </section>

  <!-- Use cases -->
  <section class="section surface-white" id={copy.ids.uses} aria-labelledby="usecases-title">
    <div class="container">
      <SectionHeader
        id="usecases-title"
        eyebrow={copy.usesEyebrow}
        title={service.useCases.heading}
        lead={service.useCases.lead}
        layout="split"
      />
      <ul class="uses" role="list">
        {
          service.useCases.items.map((item, i) => (
            <li data-reveal style={`--reveal-delay:${(i % 3) * 80}`}>
              <span class="uses__num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="h4">{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Advantages -->
  <section class="section surface-ink advantages" id={copy.ids.advantages} aria-labelledby="adv-title">
    <div class="container">
      <SectionHeader id="adv-title" eyebrow={copy.sections.advantages} title={copy.advTitle} accent={copy.advAccent} layout="split">
        <p class="lead">{copy.advLead}</p>
      </SectionHeader>
      <ol class="adv" role="list">
        {
          service.advantages.map((a, i) => (
            <li data-reveal style={`--reveal-delay:${i * 80}`}>
              <span class="adv__num">0{i + 1}</span>
              <h3 class="adv__title">{a.title}</h3>
              <p>{a.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Process -->
  <section class="section" id={copy.ids.process} aria-labelledby="process-title">
    <div class="container">
      <SectionHeader
        id="process-title"
        eyebrow={copy.sections.process}
        title={copy.processTitle}
        accent={copy.processAccent}
        lead={copy.processLead}
        layout="split"
      />
      <ProcessSteps steps={steps} />
    </div>
  </section>

  <!-- Capabilities -->
  <section class="section surface-paper-2" id={copy.ids.capabilities} aria-labelledby="cap-title">
    <div class="container cap">
      <div class="cap__head" data-reveal>
        <p class="eyebrow">{copy.capEyebrow}</p>
        <h2 class="h2" id="cap-title">{copy.capTitle} <em>{copy.capAccent}</em></h2>
        <p class="lead">{copy.capLead}</p>
        <div class="btn-row">
          <a href={quoteHref} class="btn">{ui.nav.requestQuote} <Icon name="arrow-right" /></a>
          <a href={pathTo(locale, 'contact')} class="btn btn--ghost">{ui.cta.contactUs}</a>
        </div>
      </div>
      <ul class="check-list cap__list" role="list" data-reveal style="--reveal-delay:120">
        {service.capabilities.map((c) => <li>{c}</li>)}
      </ul>
    </div>
  </section>

  <!-- Related -->
  <section class="section" aria-labelledby="related-title">
    <div class="container">
      <SectionHeader id="related-title" eyebrow={copy.relatedEyebrow} title={copy.relatedTitle} accent={copy.relatedAccent} layout="split">
        <a href={pathTo(locale, 'services')} class="link-arrow">{ui.nav.allServices} <Icon name="arrow-right" /></a>
      </SectionHeader>
      <div class="related">
        {related.map((s, i) => <ServiceCard service={s} index={i} />)}
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow={service.navTitle}
    title={copy.ctaTitle}
    accent={copy.ctaAccent}
    image={service.detailImage}
    primaryHref={quoteHref}
  />
</BaseLayout>

<style>
  /* Hero table of contents */
  .toc {
    min-width: 240px;
    padding: 1.25rem 1.5rem;
    background: rgba(5, 9, 15, 0.45);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border: 1px solid var(--line-inv);
  }

  .toc__label {
    padding-bottom: 0.85rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--line-inv);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-300);
  }

  .toc a {
    display: flex;
    gap: 0.85rem;
    padding: 0.4rem 0;
    font-size: var(--fs-small);
    color: var(--text-inv-2);
    transition: color 0.25s;
  }

  .toc a:hover {
    color: var(--white);
  }

  .toc span {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-inv-3);
  }

  @media (max-width: 899px) {
    .toc {
      display: none;
    }
  }

  /* Overview */
  .overview__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 2.5rem clamp(3rem, 7vw, 8rem);
  }

  .overview__head .h2 {
    margin-top: 1.25rem;
    max-width: 20ch;
  }

  .overview__p {
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .overview__quote {
    margin-top: 2.5rem;
    padding-left: 1.5rem;
    border-left: 1px solid var(--brand);
  }

  .overview__quote p {
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.5rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--text);
  }

  .overview__figure {
    margin-top: clamp(3.5rem, 3rem + 4vw, 6.5rem);
  }

  .overview__media {
    aspect-ratio: 21 / 9;
    overflow: hidden;
    background: var(--ink-800);
  }

  .overview__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 899px) {
    .overview__grid {
      grid-template-columns: 1fr;
    }

    .overview__media {
      aspect-ratio: 4 / 3;
    }
  }

  /* Use cases */
  .uses {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 2rem;
  }

  .uses li {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.75rem 0 2.5rem;
    border-top: 1px solid var(--line);
  }

  .uses__num {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--brand);
  }

  .uses p {
    font-size: var(--fs-small);
    color: var(--text-2);
    max-width: 38ch;
  }

  @media (max-width: 899px) {
    .uses {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 559px) {
    .uses {
      grid-template-columns: 1fr;
    }

    .uses li {
      padding-bottom: 1.75rem;
    }
  }

  /* Advantages */
  .adv {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line-inv-strong);
  }

  .adv li {
    display: grid;
    align-content: start;
    gap: 0.85rem;
    padding: 2rem 1.75rem 0.5rem;
    border-left: 1px solid var(--line-inv);
  }

  .adv li:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .adv__num {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--brand-300);
  }

  .adv__title {
    font-size: clamp(1.2rem, 1.1rem + 0.4vw, 1.4rem);
    line-height: 1.15;
  }

  .adv p {
    font-size: var(--fs-small);
    color: var(--text-inv-2);
  }

  @media (max-width: 1023px) {
    .adv {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .adv li {
      padding: 1.75rem 1.25rem 1.75rem;
    }

    .adv li:nth-child(odd) {
      padding-left: 0;
      border-left: 0;
    }

    .adv li:nth-child(n + 3) {
      border-top: 1px solid var(--line-inv);
    }
  }

  @media (max-width: 559px) {
    .adv {
      grid-template-columns: 1fr;
    }

    .adv li {
      padding: 1.5rem 0;
      border-left: 0;
    }

    .adv li + li {
      border-top: 1px solid var(--line-inv);
    }
  }

  /* Capabilities */
  .cap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 3rem clamp(3rem, 7vw, 8rem);
    align-items: start;
  }

  .cap__head {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }

  .cap__head .h2 em {
    font-weight: 300;
    color: var(--brand-600);
  }

  .cap__list li {
    font-size: 1.0625rem;
    color: var(--text);
  }

  @media (max-width: 899px) {
    .cap {
      grid-template-columns: 1fr;
    }
  }

  /* Related */
  .related {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
  }

  @media (max-width: 899px) {
    .related {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
