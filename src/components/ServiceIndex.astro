---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { getServices, getCategories, type LocalizedService } from '@/data/services';
import { getLocale } from '@/i18n/config';

interface Props {
  items?: LocalizedService[];
  /** Show the category tag on each row */
  showCategory?: boolean;
}

const locale = getLocale(Astro.url);
const categories = getCategories(locale);
const { items = getServices(locale), showCategory = true } = Astro.props;
---

<div class="sx" data-service-index>
  <ol class="sx__list" role="list">
    {
      items.map((s, i) => (
        <li class="sx__item" data-reveal style={`--reveal-delay:${Math.min(i, 6) * 50}`}>
          <a href={s.href} class="sx__row" data-index={i} data-active={i === 0 ? 'true' : undefined}>
            <span class="sx__num">{String(i + 1).padStart(2, '0')}</span>
            <span class="sx__thumb" aria-hidden="true">
              <Image src={s.image} alt="" widths={[160, 240]} sizes="80px" loading="lazy" />
            </span>
            <span class="sx__body">
              <span class="sx__title">{s.title}</span>
              <span class="sx__summary">{s.summary}</span>
            </span>
            {showCategory && <span class="sx__cat">{categories[s.category].label}</span>}
            <span class="sx__arrow" aria-hidden="true">
              <Icon name="arrow-up-right" size={20} />
            </span>
          </a>
        </li>
      ))
    }
  </ol>

  <div class="sx__panel" aria-hidden="true">
    <div class="sx__frame">
      {
        items.map((s, i) => (
          <div class="sx__img" data-panel={i} data-active={i === 0 ? 'true' : undefined}>
            <Image src={s.image} alt="" widths={[560, 800, 1100]} sizes="(min-width: 1360px) 520px, 38vw" loading="lazy" />
          </div>
        ))
      }
      <div class="sx__caption">
        {
          items.map((s, i) => (
            <p data-caption={i} data-active={i === 0 ? 'true' : undefined}>
              <span>{String(i + 1).padStart(2, '0')}</span> {s.navTitle}
            </p>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .sx {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.72fr);
    gap: clamp(2rem, 4vw, 5rem);
    align-items: start;
  }

  .sx__list {
    border-top: 1px solid var(--line);
  }

  .sx__item {
    border-bottom: 1px solid var(--line);
  }

  .sx__row {
    position: relative;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto 2rem;
    align-items: center;
    gap: 1.25rem;
    padding: 1.35rem 0;
    transition: padding 0.5s var(--ease-out);
  }

  .sx__row::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--brand);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease-out);
  }

  .sx__thumb {
    display: none;
  }

  .sx__num {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--text-3);
    transition: color 0.3s;
  }

  .sx__body {
    display: grid;
    gap: 0.35rem;
  }

  .sx__title {
    font-family: var(--font-serif);
    font-size: clamp(1.2rem, 1.05rem + 0.55vw, 1.6rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    transition: color 0.3s;
  }

  .sx__summary {
    font-size: var(--fs-small);
    color: var(--text-3);
    max-width: 52ch;
    line-height: 1.5;
  }

  .sx__cat {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
    white-space: nowrap;
  }

  .sx__arrow {
    display: grid;
    place-items: center;
    color: var(--text-3);
    transition:
      color 0.3s,
      transform 0.5s var(--ease-out);
  }

  .sx__row:hover::before,
  .sx__row:focus-visible::before,
  .sx__row[data-active='true']::before {
    transform: scaleX(1);
  }

  .sx__row:hover .sx__title,
  .sx__row:focus-visible .sx__title {
    color: var(--brand-600);
  }

  .sx__row:hover .sx__num,
  .sx__row[data-active='true'] .sx__num {
    color: var(--brand);
  }

  .sx__row:hover .sx__arrow,
  .sx__row:focus-visible .sx__arrow {
    color: var(--brand);
    transform: translate(3px, -3px);
  }

  /* ---------- Sticky image panel ---------- */
  .sx__panel {
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }

  .sx__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--ink-800);
  }

  .sx__img {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 0.7s var(--ease-out),
      transform 1.4s var(--ease-out);
  }

  .sx__img[data-active='true'] {
    opacity: 1;
    transform: scale(1);
  }

  .sx__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sx__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 3rem 1.5rem 1.25rem;
    background: linear-gradient(to top, rgba(5, 9, 15, 0.75), transparent);
    color: var(--white);
  }

  .sx__caption p {
    position: absolute;
    left: 1.5rem;
    bottom: 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.4s,
      transform 0.5s var(--ease-out);
  }

  .sx__caption p span {
    color: var(--brand-300);
    margin-right: 0.5rem;
  }

  .sx__caption p[data-active='true'] {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 1100px) {
    .sx__cat {
      display: none;
    }

    .sx__row {
      grid-template-columns: 2.5rem minmax(0, 1fr) 2rem;
    }
  }

  @media (max-width: 899px) {
    .sx {
      grid-template-columns: 1fr;
    }

    .sx__panel {
      display: none;
    }

    .sx__row {
      grid-template-columns: 72px minmax(0, 1fr) 1.5rem;
      gap: 1rem;
      padding: 1.1rem 0;
    }

    .sx__num {
      display: none;
    }

    .sx__thumb {
      display: block;
      width: 72px;
      aspect-ratio: 1;
      overflow: hidden;
      background: var(--ink-800);
    }

    .sx__thumb :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .sx__row[data-active='true']::before {
      transform: scaleX(0);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-service-index]').forEach((root) => {
    const rows = root.querySelectorAll<HTMLAnchorElement>('.sx__row');
    const panels = root.querySelectorAll<HTMLElement>('[data-panel]');
    const captions = root.querySelectorAll<HTMLElement>('[data-caption]');

    const activate = (index: number) => {
      rows.forEach((r, i) => (r.dataset.active = String(i === index)));
      panels.forEach((p, i) => (p.dataset.active = String(i === index)));
      captions.forEach((c, i) => (c.dataset.active = String(i === index)));
    };

    rows.forEach((row, i) => {
      row.addEventListener('mouseenter', () => activate(i));
      row.addEventListener('focus', () => activate(i));
    });
  });
</script>
