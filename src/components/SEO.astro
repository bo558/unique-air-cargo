---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '@/data/site';
import { withBase, stripBase } from '@/utils/paths';
import defaultOg from '@/assets/images/hero-freighter-night.jpg';

export interface SeoProps {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  noindex?: boolean;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = site.defaultDescription, image, noindex = false, type = 'website', jsonLd } =
  Astro.props as SeoProps;

// Preview deployments (e.g. GitHub Pages) must never be indexed alongside the real domain.
const isPreview = import.meta.env.PUBLIC_PREVIEW === 'true';
const robots = isPreview ? 'noindex, nofollow' : noindex ? 'noindex, follow' : undefined;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | Kargo ve Yolcu Charter Uçuşları`;
// Same shape as the sitemap: extension-less, root with trailing slash ("/", "/kurumsal", "/hizmetler/x").
const route = stripBase(Astro.url.pathname.replace(/\.html$/, '').replace(/(^|\/)index$/, '$1'));
const canonical = new URL(withBase(route), Astro.site).href;

const og = await getImage({
  src: image ?? defaultOg,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'center',
  format: 'jpg',
  quality: 78,
});
const ogUrl = new URL(og.src, Astro.site).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  logo: `${site.url}/brand/logo.png`,
  slogan: site.tagline,
  email: site.contact.email,
  telephone: site.contact.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.contact.address.street,
    addressLocality: `${site.contact.address.district}, ${site.contact.address.city}`,
    postalCode: site.contact.address.postalCode,
    addressCountry: 'TR',
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: site.contact.phone,
      email: site.contact.email,
      contactType: 'sales',
      availableLanguage: ['Turkish', 'English'],
    },
  ],
};

const schemas = [organization, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{robots && <meta name="robots" content={robots} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

{schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
