---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '@/data/site';
import { withBase, stripBase } from '@/utils/paths';
import { projectImage } from '@/data/projects';

const defaultOg = projectImage('ataturk-airport-last-flight', 2);
import { getLocale, translatePath, localeMeta, locales, defaultLocale } from '@/i18n/config';
import { t } from '@/i18n/ui';

const locale = getLocale(Astro.url);
const ui = t(locale);

export interface SeoProps {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  noindex?: boolean;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description = ui.seo.description, image, noindex = false, type = 'website', jsonLd } =
  Astro.props as SeoProps;

// Preview deployments (e.g. GitHub Pages) must never be indexed alongside the real domain.
const isPreview = import.meta.env.PUBLIC_PREVIEW === 'true';
const robots = isPreview ? 'noindex, nofollow' : noindex ? 'noindex, follow' : undefined;

const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${ui.seo.suffix}`;

// Language alternates (same page in every locale) for hreflang
const alternates = locales.map((l) => ({ hreflang: localeMeta[l].htmlLang, href: new URL(translatePath(Astro.url, l), Astro.site).href }));
const xDefault = alternates[locales.indexOf(defaultLocale)].href;
// Same shape as the sitemap: extension-less, root with trailing slash ("/", "/kurumsal", "/hizmetler/x").
const route = stripBase(Astro.url.pathname.replace(/\.html$/, '').replace(/(^|\/)index$/, '$1'));
const canonical = new URL(withBase(route), Astro.site).href;

const og = await getImage({
  src: image ?? defaultOg,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'center',
  format: 'jpg',
  quality: 78,
});
const ogUrl = new URL(og.src, Astro.site).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  logo: `${site.url}/brand/logo.png`,
  slogan: site.tagline,
  email: site.contact.email,
  telephone: site.contact.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.contact.address.street,
    addressLocality: `${site.contact.address.district}, ${site.contact.address.city}`,
    postalCode: site.contact.address.postalCode,
    addressCountry: 'TR',
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: site.contact.phone,
      email: site.contact.email,
      contactType: 'sales',
      availableLanguage: ['Turkish', 'English'],
    },
  ],
};

const schemas = [organization, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
{!noindex && <link rel="alternate" hreflang="x-default" href={xDefault} />}
{robots && <meta name="robots" content={robots} />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={localeMeta[locale].og} />
{locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={localeMeta[l].og} />)}
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogUrl} />

{schemas.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
