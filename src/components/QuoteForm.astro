---
import Icon from './Icon.astro';
import { getServicesByCategory } from '@/data/services';
import { site } from '@/data/site';
import { getLocale, pathTo } from '@/i18n/config';
import { t } from '@/i18n/ui';

const locale = getLocale(Astro.url);
const ui = t(locale);
const f = ui.form;
const categories = getServicesByCategory(locale);
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
// Copy the client script needs (validation messages, email draft labels, status texts)
const clientCopy = JSON.stringify({
  messages: f.messages,
  mail: f.mail,
  successMailto: f.successMailto,
  error: f.error,
  submit: f.submit,
  sending: f.sending,
});
---

<div class="qf" data-quote-form data-endpoint={endpoint} data-email={site.contact.email} data-copy={clientCopy}>
  <form class="qf__form" novalidate>
    <fieldset class="qf__set">
      <legend class="qf__legend"><span>01</span> {f.section1}</legend>

      <div class="qf__grid">
        <div class="field field--full">
          <label for="qf-service">{f.service} <span class="req" aria-hidden="true">*</span></label>
          <div class="select">
            <select id="qf-service" name="service" required aria-describedby="qf-service-err">
              <option value="">{f.select}</option>
              {
                categories.map((cat) => (
                  <optgroup label={cat.label}>
                    {cat.services.map((s) => (
                      <option value={s.id}>{s.title}</option>
                    ))}
                  </optgroup>
                ))
              }
              <option value="other">{f.other}</option>
            </select>
            <Icon name="chevron-down" size={16} />
          </div>
          <p class="field__error" id="qf-service-err" aria-live="polite"></p>
        </div>

        <div class="field">
          <label for="qf-from">{f.from} <span class="req" aria-hidden="true">*</span></label>
          <input id="qf-from" name="from" type="text" required autocomplete="off" placeholder={f.placeholderPlace} aria-describedby="qf-from-err" />
          <p class="field__error" id="qf-from-err" aria-live="polite"></p>
        </div>

        <div class="field">
          <label for="qf-to">{f.to} <span class="req" aria-hidden="true">*</span></label>
          <input id="qf-to" name="to" type="text" required autocomplete="off" placeholder={f.placeholderPlace} aria-describedby="qf-to-err" />
          <p class="field__error" id="qf-to-err" aria-live="polite"></p>
        </div>

        <div class="field">
          <label for="qf-date">{f.date}</label>
          <input id="qf-date" name="date" type="date" lang={locale} />
        </div>

        <div class="field field--check-inline">
          <label class="check">
            <input type="checkbox" name="flexible" value="yes" />
            <span class="check__box" aria-hidden="true"><Icon name="check" size={14} /></span>
            <span>{f.flexible}</span>
          </label>
        </div>

        <div class="field field--full">
          <label for="qf-details">{f.details} <span class="req" aria-hidden="true">*</span></label>
          <textarea
            id="qf-details"
            name="details"
            rows="5"
            required
            minlength="10"
            aria-describedby="qf-details-hint qf-details-err"></textarea>
          <p class="field__hint" id="qf-details-hint">{f.detailsHint}</p>
          <p class="field__error" id="qf-details-err" aria-live="polite"></p>
        </div>
      </div>
    </fieldset>

    <fieldset class="qf__set">
      <legend class="qf__legend"><span>02</span> {f.section2}</legend>

      <div class="qf__grid">
        <div class="field">
          <label for="qf-name">{f.name} <span class="req" aria-hidden="true">*</span></label>
          <input id="qf-name" name="name" type="text" required autocomplete="name" aria-describedby="qf-name-err" />
          <p class="field__error" id="qf-name-err" aria-live="polite"></p>
        </div>

        <div class="field">
          <label for="qf-company">{f.company}</label>
          <input id="qf-company" name="company" type="text" autocomplete="organization" />
        </div>

        <div class="field">
          <label for="qf-email">{f.email} <span class="req" aria-hidden="true">*</span></label>
          <input id="qf-email" name="email" type="email" required autocomplete="email" inputmode="email" aria-describedby="qf-email-err" />
          <p class="field__error" id="qf-email-err" aria-live="polite"></p>
        </div>

        <div class="field">
          <label for="qf-phone">{f.phone} <span class="req" aria-hidden="true">*</span></label>
          <input id="qf-phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" placeholder="+90" aria-describedby="qf-phone-err" />
          <p class="field__error" id="qf-phone-err" aria-live="polite"></p>
        </div>

        <div class="field field--hp" aria-hidden="true">
          <label for="qf-website">{f.website}</label>
          <input id="qf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="field field--full">
          <label class="check">
            <input type="checkbox" name="consent" value="yes" required aria-describedby="qf-consent-err" />
            <span class="check__box" aria-hidden="true"><Icon name="check" size={14} /></span>
            <span>
              {f.consentBefore} <a href={pathTo(locale, 'privacy')} target="_blank">{f.consentLink}</a>
              {f.consentAfter} <span class="req" aria-hidden="true">*</span>
            </span>
          </label>
          <p class="field__error" id="qf-consent-err" aria-live="polite"></p>
        </div>
      </div>
    </fieldset>

    <div class="qf__submit">
      <button type="submit" class="btn qf__btn">
        <span class="qf__btn-label">{f.submit}</span>
        <Icon name="arrow-right" />
      </button>
      <p class="qf__note"><span class="req">*</span> {f.required}</p>
    </div>

    <p class="qf__status" role="alert" aria-live="assertive" hidden></p>
  </form>

  <div class="qf__success" tabindex="-1" hidden>
    <span class="qf__success-icon" aria-hidden="true"><Icon name="check" size={26} /></span>
    <h3 class="qf__success-title">{f.successTitle}</h3>
    <p class="qf__success-text" data-success-text>{f.successText}</p>
    <div class="btn-row">
      <a href={site.contact.phoneHref} class="btn btn--ink"><Icon name="phone" /> {site.contact.phone}</a>
      <button type="button" class="btn btn--ghost" data-reset>{f.newRequest}</button>
    </div>
  </div>
</div>

<style>
  .qf__set {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  .qf__set + .qf__set {
    margin-top: 2.75rem;
  }

  .qf__legend {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    width: 100%;
    padding-bottom: 1rem;
    margin-bottom: 1.75rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-serif);
    font-size: 1.45rem;
    letter-spacing: -0.015em;
  }

  .qf__legend span {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--brand);
  }

  .qf__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.4rem 1.25rem;
  }

  .field {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    min-width: 0;
  }

  .field--full {
    grid-column: 1 / -1;
  }

  .field--check-inline {
    align-content: end;
    padding-bottom: 0.9rem;
  }

  .field--hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .field > label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
  }

  .req {
    color: var(--brand);
  }

  .field input[type='text'],
  .field input[type='email'],
  .field input[type='tel'],
  .field input[type='date'],
  .field select,
  .field textarea {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    font-size: 1rem;
    line-height: 1.4;
    color: var(--text);
    transition:
      border-color 0.25s,
      box-shadow 0.25s;
    appearance: none;
  }

  .field textarea {
    resize: vertical;
    min-height: 8.5rem;
  }

  .field ::placeholder {
    color: #9aa0a9;
  }

  .field input:hover,
  .field select:hover,
  .field textarea:hover {
    border-color: #bfb7a9;
  }

  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--brand);
    box-shadow: 0 0 0 3px rgba(10, 122, 159, 0.14);
  }

  .field [aria-invalid='true'] {
    border-color: #b42318;
  }

  .field [aria-invalid='true']:focus {
    box-shadow: 0 0 0 3px rgba(180, 35, 24, 0.14);
  }

  .select {
    position: relative;
  }

  .select select {
    padding-right: 2.75rem;
    cursor: pointer;
  }

  .select :global(svg) {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    color: var(--text-3);
  }

  .field__hint {
    font-size: var(--fs-xs);
    color: var(--text-3);
  }

  .field__error {
    font-size: var(--fs-xs);
    font-weight: 500;
    color: #b42318;
  }

  .field__error:empty {
    display: none;
  }

  .check {
    position: relative;
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: 0.75rem;
    align-items: start;
    font-size: var(--fs-small);
    font-weight: 400;
    color: var(--text-2);
    cursor: pointer;
  }

  .check input {
    position: absolute;
    opacity: 0;
    width: 1.25rem;
    height: 1.25rem;
    margin: 0;
    cursor: pointer;
  }

  .check__box {
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.1rem;
    border: 1px solid #b8b0a2;
    border-radius: var(--radius);
    background: var(--white);
    color: transparent;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s;
  }

  .check input:checked + .check__box {
    background: var(--brand);
    border-color: var(--brand);
    color: var(--white);
  }

  .check input:focus-visible + .check__box {
    outline: 2px solid var(--brand-400);
    outline-offset: 2px;
  }

  .check input[aria-invalid='true'] + .check__box {
    border-color: #b42318;
  }

  .check a {
    color: var(--brand-600);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .qf__submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2.25rem;
  }

  .qf__btn[disabled] {
    opacity: 0.7;
    cursor: progress;
  }

  .qf__note {
    font-size: var(--fs-xs);
    color: var(--text-3);
  }

  .qf__status {
    margin-top: 1.25rem;
    padding: 1rem 1.25rem;
    border-left: 2px solid #b42318;
    background: #fbefed;
    font-size: var(--fs-small);
    color: #7a1c13;
  }

  .qf__status a {
    text-decoration: underline;
  }

  .qf__success {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding: clamp(2rem, 4vw, 3rem);
    border: 1px solid var(--line);
    background: var(--white);
    outline: none;
  }

  .qf__success-icon {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    background: var(--brand-100);
    color: var(--brand-600);
  }

  .qf__success-title {
    font-size: var(--fs-h3);
  }

  .qf__success-text {
    max-width: 52ch;
    color: var(--text-2);
  }

  .qf__success .btn-row {
    margin-top: 0.75rem;
  }

  @media (max-width: 639px) {
    .qf__grid {
      grid-template-columns: 1fr;
    }

    .field--check-inline {
      padding-bottom: 0;
    }

    .qf__btn {
      width: 100%;
    }
  }
</style>

<script>
  type Field = HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;

  interface Copy {
    messages: Record<string, string>;
    mail: Record<string, string>;
    successMailto: string;
    error: string;
    submit: string;
    sending: string;
  }

  document.querySelectorAll<HTMLElement>('[data-quote-form]').forEach((root) => {
    const copy: Copy = JSON.parse(root.dataset.copy ?? '{}');
    const m = copy.messages;
    const form = root.querySelector('form')!;
    const success = root.querySelector<HTMLElement>('.qf__success')!;
    const successText = root.querySelector<HTMLElement>('[data-success-text]')!;
    const status = root.querySelector<HTMLElement>('.qf__status')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const submitLabel = submit.querySelector<HTMLElement>('.qf__btn-label')!;
    const endpoint = root.dataset.endpoint?.trim();
    const email = root.dataset.email!;
    const defaultSuccess = successText.textContent;

    const rules: Record<string, (el: Field) => string> = {
      service: (el) => (el.value ? '' : m.service),
      from: (el) => (el.value.trim().length >= 2 ? '' : m.from),
      to: (el) => (el.value.trim().length >= 2 ? '' : m.to),
      details: (el) => (el.value.trim().length >= 10 ? '' : m.details),
      name: (el) => (el.value.trim().length >= 3 ? '' : m.name),
      email: (el) =>
        !el.value.trim() ? m.emailEmpty : /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(el.value.trim()) ? '' : m.emailInvalid,
      phone: (el) => {
        const digits = el.value.replace(/\D/g, '');
        if (!digits) return m.phoneEmpty;
        return digits.length >= 10 && digits.length <= 15 ? '' : m.phoneInvalid;
      },
      consent: (el) => ((el as HTMLInputElement).checked ? '' : m.consent),
    };

    const field = (name: string) => form.elements.namedItem(name) as Field;

    // Preselect a service from ?service=<id> (links from service pages)
    const select = field('service') as HTMLSelectElement;
    const preset = new URLSearchParams(window.location.search).get('service');
    if (preset && Array.from(select.options).some((o) => o.value === preset)) select.value = preset;

    (field('date') as HTMLInputElement).min = new Date().toISOString().slice(0, 10);

    const validate = (name: string) => {
      const el = field(name);
      const msg = rules[name](el);
      const errId = el.getAttribute('aria-describedby')?.split(' ').pop();
      const err = errId ? root.querySelector<HTMLElement>(`#${errId}`) : null;
      el.setAttribute('aria-invalid', String(Boolean(msg)));
      if (err) err.textContent = msg;
      return !msg;
    };

    Object.keys(rules).forEach((name) => {
      const el = field(name);
      const evt = el instanceof HTMLInputElement && el.type === 'checkbox' ? 'change' : 'blur';
      el.addEventListener(evt, (e) => {
        // Moving straight to the submit button: let the submit handler validate everything.
        // Showing an error here would shift the layout and make the click miss the button.
        if (e instanceof FocusEvent && e.relatedTarget === submit) return;
        validate(name);
      });
      el.addEventListener('input', () => {
        if (el.getAttribute('aria-invalid') === 'true') validate(name);
      });
    });

    const payload = () => {
      const data = new FormData(form);
      const value = (k: string) => String(data.get(k) ?? '').trim();
      return {
        service: select.selectedOptions[0]?.textContent?.trim() ?? '',
        from: value('from'),
        to: value('to'),
        date: value('date') || copy.mail.notSpecified,
        flexible: data.get('flexible') ? copy.mail.yes : copy.mail.no,
        details: value('details'),
        name: value('name'),
        company: value('company') || '-',
        email: value('email'),
        phone: value('phone'),
        language: document.documentElement.lang,
        page: window.location.href,
      };
    };

    const showSuccess = (text?: string) => {
      successText.textContent = text ?? defaultSuccess;
      form.hidden = true;
      success.hidden = false;
      success.focus();
      success.scrollIntoView({ behavior: 'smooth', block: 'center' });
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      status.hidden = true;

      const invalid = Object.keys(rules).filter((name) => !validate(name));
      if (invalid.length) {
        field(invalid[0]).focus();
        return;
      }

      // Honeypot: silently accept bots without sending anything.
      if ((field('website') as HTMLInputElement).value) {
        showSuccess();
        return;
      }

      const data = payload();
      const l = copy.mail;

      if (!endpoint) {
        const body = [
          `${l.service}: ${data.service}`,
          `${l.from}: ${data.from}`,
          `${l.to}: ${data.to}`,
          `${l.date}: ${data.date} (${l.flexible}: ${data.flexible})`,
          '',
          `${l.details}:`,
          data.details,
          '',
          `${l.name}: ${data.name}`,
          `${l.company}: ${data.company}`,
          `${l.email}: ${data.email}`,
          `${l.phone}: ${data.phone}`,
        ].join('\n');
        const subject = `${l.subject}: ${data.service} — ${data.from} → ${data.to}`;
        window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        showSuccess(copy.successMailto);
        return;
      }

      submit.disabled = true;
      submitLabel.textContent = copy.sending;
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        showSuccess();
      } catch {
        status.textContent = `${copy.error} `;
        const link = document.createElement('a');
        link.href = `mailto:${email}`;
        link.textContent = email;
        status.append(link);
        status.hidden = false;
      } finally {
        submit.disabled = false;
        submitLabel.textContent = copy.submit;
      }
    });

    root.querySelector('[data-reset]')?.addEventListener('click', () => {
      form.reset();
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
      success.hidden = true;
      form.hidden = false;
      select.focus();
    });
  });
</script>
