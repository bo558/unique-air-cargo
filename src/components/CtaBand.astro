---
import { withBase } from '@/utils/paths';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from './Icon.astro';
import { site } from '@/data/site';
import defaultImage from '@/assets/images/wing-clouds.jpg';

interface Props {
  eyebrow?: string;
  title?: string;
  accent?: string;
  text?: string;
  image?: ImageMetadata;
  primaryLabel?: string;
  primaryHref?: string;
}

const {
  eyebrow = 'Teklif & Planlama',
  title = 'Bir sonraki operasyonunuzu',
  accent = 'birlikte planlayalım.',
  text = 'Rota, tarih ve yük ya da yolcu bilgilerinizi paylaşın; uygun uçak seçeneklerini ve net bir teklifi en kısa sürede iletelim.',
  image = defaultImage,
  primaryLabel = 'Teklif Al',
  primaryHref = '/iletisim#teklif',
} = Astro.props;
---

<section class="cta on-dark" aria-labelledby="cta-title">
  <div class="cta__media" data-reveal="fade">
    <Picture
      src={image}
      alt=""
      formats={['avif', 'webp']}
      widths={[640, 1024, 1600, 2200]}
      sizes="100vw"
      loading="lazy"
    />
  </div>
  <div class="container cta__inner">
    <div class="cta__content" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h2 class="cta__title" id="cta-title">
        {title} <em>{accent}</em>
      </h2>
      <p class="cta__text">{text}</p>
      <div class="btn-row">
        <a href={withBase(primaryHref)} class="btn btn--light">{primaryLabel} <Icon name="arrow-right" /></a>
        <a href={withBase('/iletisim')} class="btn btn--ghost-light">Bizimle İletişime Geçin</a>
      </div>
    </div>
    <dl class="cta__contact" data-reveal style="--reveal-delay:150">
      <div>
        <dt>Telefon</dt>
        <dd><a href={site.contact.phoneHref}>{site.contact.phone}</a></dd>
      </div>
      <div>
        <dt>E-posta</dt>
        <dd><a href={`mailto:${site.contact.email}`}>{site.contact.email}</a></dd>
      </div>
      <div>
        <dt>Merkez</dt>
        <dd>{site.contact.address.district}, {site.contact.address.city}</dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .cta {
    position: relative;
    background: var(--ink-950);
    color: var(--text-inv);
    isolation: isolate;
    overflow: hidden;
  }

  .cta__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .cta__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgba(5, 9, 15, 0.9) 0%, rgba(5, 9, 15, 0.55) 55%, rgba(5, 9, 15, 0.35) 100%),
      linear-gradient(to top, rgba(5, 9, 15, 0.6), transparent 50%);
  }

  .cta__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cta__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: end;
    gap: 3rem 5rem;
    padding-block: clamp(5.5rem, 4rem + 7vw, 10rem);
  }

  .cta__title {
    margin-top: 1.5rem;
    font-size: var(--fs-h2);
    max-width: 16ch;
  }

  .cta__title em {
    display: block;
    font-weight: 300;
    color: var(--brand-200);
  }

  .cta__text {
    max-width: 50ch;
    margin: 1.5rem 0 2.5rem;
    font-size: var(--fs-lead);
    color: var(--text-inv-2);
  }

  .cta__contact {
    display: grid;
    border-top: 1px solid var(--line-inv-strong);
  }

  .cta__contact > div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line-inv);
  }

  .cta__contact dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-inv-3);
    padding-top: 0.2rem;
  }

  .cta__contact dd {
    font-size: 1.0625rem;
    overflow-wrap: anywhere;
  }

  .cta__contact a:hover {
    color: var(--brand-300);
  }

  @media (max-width: 899px) {
    .cta__inner {
      grid-template-columns: 1fr;
    }
  }
</style>
