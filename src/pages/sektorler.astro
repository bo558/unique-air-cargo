---
import { withBase } from '@/utils/paths';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ScenarioTabs from '@/components/ScenarioTabs.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { sectors } from '@/data/sectors';
import { getService, serviceHref } from '@/data/services';

import heroImage from '@/assets/images/an124-landing.jpg';
import ctaImage from '@/assets/images/turboprop-silhouette.jpg';
---

<BaseLayout
  title="Sektörel Çözümler"
  description="Enerji, petrol ve gaz, inşaat ve altyapı, havacılık ve denizcilik, otomotiv ve üretim, sağlık, kamu ve insani yardım ile eğlence ve spor sektörleri için charter hava taşımacılığı çözümleri."
  image={heroImage}
>
  <PageHero
    eyebrow="Sektörel çözümler"
    title="Sektörünüzün ritmini"
    accent="bilen bir ekip."
    lead="Her sektörün aciliyeti, yükü ve kuralları farklıdır. Charter çözümlerimizi; enerjiden sağlığa, altyapı projelerinden etkinlik organizasyonlarına kadar sektörün gerçek ihtiyaçlarına göre kurguluyoruz."
    image={heroImage}
    imageAlt="İnişe yaklaşan dört motorlu ağır nakliye uçağı"
    crumbs={[{ label: 'Sektörler' }]}
  >
    <a href={withBase('/iletisim#teklif')} class="btn btn--light">Teklif Al <Icon name="arrow-right" /></a>
    <a href="#sektorler" class="btn btn--ghost-light">Sektörleri İnceleyin <Icon name="arrow-down" /></a>
  </PageHero>

  <nav class="sec-nav" id="sektorler" aria-label="Sektörler">
    <div class="container sec-nav__inner">
      {
        sectors.map((s, i) => (
          <a href={`#${s.id}`}>
            <span>0{i + 1}</span>
            {s.title}
          </a>
        ))
      }
    </div>
  </nav>

  <div class="sectors">
    {
      sectors.map((s, i) => (
        <section class:list={['section', 'sector', i % 2 === 1 && 'sector--alt']} id={s.id} aria-labelledby={`${s.id}-title`}>
          <div class="container sector__grid">
            <div class="sector__media" data-reveal-mask>
              <Image src={s.image} alt={s.imageAlt} widths={[560, 840, 1200]} sizes="(min-width: 1024px) 44vw, 92vw" loading="lazy" />
              <span class="sector__index">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="sector__content">
              <p class="eyebrow" data-reveal>Sektör {String(i + 1).padStart(2, '0')}</p>
              <h2 class="h2 sector__title" id={`${s.id}-title`} data-reveal>
                {s.title}
              </h2>
              <p class="sector__challenge" data-reveal>{s.challenge}</p>
              <p class="sector__body" data-reveal>{s.body}</p>

              <h3 class="sector__sub" data-reveal>Tipik ihtiyaçlar</h3>
              <ul class="check-list" role="list" data-reveal>
                {s.needs.map((n) => <li>{n}</li>)}
              </ul>

              {s.context && (
                <aside class="sector__context" data-reveal>
                  <p class="sector__context-label">{s.context.label}</p>
                  <p>{s.context.text}</p>
                </aside>
              )}

              <div class="sector__links" data-reveal>
                <p class="sector__sub">İlgili hizmetler</p>
                <ul role="list">
                  {s.services.map((slug) => {
                    const svc = getService(slug);
                    return svc ? (
                      <li>
                        <a href={serviceHref(slug)}>
                          {svc.navTitle} <Icon name="arrow-up-right" size={15} />
                        </a>
                      </li>
                    ) : null;
                  })}
                </ul>
              </div>
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <section class="section surface-white" aria-labelledby="scenarios-title">
    <div class="container">
      <SectionHeader
        id="scenarios-title"
        eyebrow="Operasyon senaryoları"
        title="Sahada nasıl"
        accent="kurgulanır?"
        lead="Temsili senaryolar; farklı sektörlerdeki tipik bir charter ihtiyacının nasıl planlandığını adım adım gösterir."
        layout="split"
      />
      <ScenarioTabs />
    </div>
  </section>

  <CtaBand
    eyebrow="Sektörünüze özel"
    title="Projenizin takvimini"
    accent="birlikte koruyalım."
    image={ctaImage}
  />
</BaseLayout>

<style>
  .sec-nav {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(246, 244, 239, 0.94);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 0;
  }

  .sec-nav__inner {
    display: flex;
    gap: 2.25rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .sec-nav__inner::-webkit-scrollbar {
    display: none;
  }

  .sec-nav a {
    flex: none;
    padding: 1.15rem 0;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-2);
    transition: color 0.25s;
  }

  .sec-nav a:hover {
    color: var(--brand-600);
  }

  .sec-nav span {
    margin-right: 0.4rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--brand);
  }

  .sector {
    scroll-margin-top: 3.5rem;
  }

  .sector + .sector {
    border-top: 1px solid var(--line);
  }

  .sector--alt {
    background: var(--white);
  }

  .sector__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem clamp(3rem, 7vw, 7rem);
    align-items: start;
  }

  .sector--alt .sector__media {
    order: 2;
  }

  .sector__media {
    position: sticky;
    top: 6rem;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--ink-800);
  }

  .sector__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sector__index {
    position: absolute;
    left: 1.25rem;
    bottom: 1rem;
    font-family: var(--font-serif);
    font-size: clamp(3rem, 2rem + 4vw, 6rem);
    font-weight: 300;
    line-height: 1;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.35);
  }

  .sector__title {
    margin-top: 1.25rem;
  }

  .sector__challenge {
    margin-top: 1.75rem;
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 1.15rem + 0.6vw, 1.65rem);
    font-style: italic;
    font-weight: 300;
    line-height: 1.35;
    color: var(--brand-700);
  }

  .sector__body {
    margin-top: 1.25rem;
    color: var(--text-2);
    line-height: 1.75;
  }

  .sector__sub {
    margin: 2.5rem 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .sector__context {
    margin-top: 2.5rem;
    padding: 1.5rem 1.75rem;
    background: var(--ink-900);
    color: var(--text-inv-2);
    font-size: var(--fs-small);
    line-height: 1.7;
  }

  .sector__context-label {
    margin-bottom: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-300);
  }

  .sector__links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .sector__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    transition:
      border-color 0.25s,
      color 0.25s,
      background-color 0.25s;
  }

  .sector__links a:hover {
    border-color: var(--brand);
    color: var(--brand-600);
    background: var(--brand-100);
  }

  @media (max-width: 899px) {
    .sector__grid {
      grid-template-columns: 1fr;
    }

    .sector--alt .sector__media {
      order: 0;
    }

    .sector__media {
      position: relative;
      top: auto;
      aspect-ratio: 16 / 10;
    }
  }
</style>
