---
import { withBase } from '@/utils/paths';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import WorldMap from '@/components/WorldMap.astro';
import CtaBand from '@/components/CtaBand.astro';
import Icon from '@/components/Icon.astro';
import { defaultProcess } from '@/data/services';
import { site } from '@/data/site';

import heroImage from '@/assets/images/apron-sunset.jpg';
import storyImage from '@/assets/images/jet-nose-golden.jpg';
import storyImage2 from '@/assets/images/cockpit.jpg';
import ctaImage from '@/assets/images/sunset-sky-plane.jpg';

const values = [
  { title: 'Önce emniyet', text: 'Uçuş emniyeti her kararın ön koşuludur; hız asla emniyetin önüne geçmez.' },
  { title: 'İhtiyacı anlamak', text: 'Çözümden önce soruyu doğru anlarız: yük, rota, zaman ve kısıtlar.' },
  { title: 'Şeffaflık', text: 'Seçenekler, kısıtlar ve maliyetler en baştan açıkça paylaşılır.' },
  { title: 'Hız', text: 'Her kiralama talebini en kısa sürede çözüme kavuşturmayı hedefleriz.' },
  { title: 'Özen', text: 'Above All, We Care: Her yük ve her yolcu bizim için tek ve özeldir.' },
];

const standards = [
  { code: 'ICAO', text: 'Uluslararası Sivil Havacılık Örgütü kurallarına uygun operasyon planlaması.' },
  { code: 'IATA', text: 'Uluslararası Hava Taşımacılığı Birliği kural ve uygulamalarına uyum.' },
  { code: 'IATA DGR', text: 'Tehlikeli Madde Regülasyonları konusunda eğitimli operasyon ekibi.' },
  { code: 'KVKK', text: 'Müşteri verilerinin 6698 sayılı Kanun kapsamında korunması.' },
];
---

<BaseLayout
  title="Kurumsal"
  description="İstanbul merkezli Unique Air Cargo; deneyimli kadrosu, 7 bölgedeki yerel temsilcileri ve ICAO & IATA kurallarına uygun operasyon anlayışıyla charter uçak kiralama hizmeti sunar."
  image={heroImage}
>
  <PageHero
    eyebrow="Kurumsal"
    title="Benzersiz olmaktan"
    accent="gurur duyuyoruz."
    lead="Unique Air Cargo, havacılık sektöründe uzun yıllar çalışmış deneyimli ve profesyonel kadrosuyla, İstanbul merkezli olarak uçak kiralama alanında hizmet veren bir havacılık şirketidir."
    image={heroImage}
    imageAlt="Gün batımında yük ve yer hizmeti araçlarıyla dolu havalimanı apronu"
    crumbs={[{ label: 'Kurumsal' }]}
    position="center 60%"
  >
    <a href="#hikaye" class="btn btn--light">Bizi Tanıyın <Icon name="arrow-down" /></a>
    <a href={withBase('/iletisim')} class="btn btn--ghost-light">Bizimle İletişime Geçin</a>
  </PageHero>

  <!-- Story -->
  <section class="section story" id="hikaye" aria-labelledby="story-title">
    <div class="container story__grid">
      <div class="story__text">
        <SectionHeader id="story-title" eyebrow="Biz kimiz" title="İstanbul’dan dünyaya" accent="uzanan bir çözüm ortağı." />
        <div class="prose story__prose" data-reveal>
          <p>
            Merkezimiz, dünyanın en güzel şehirlerinden biri olan ve Asya ile Avrupa’yı birbirine bağlayan
            <strong>İstanbul’da</strong>. Bu konum; Avrupa, Orta Doğu, Afrika ve Asya arasındaki operasyonlarda bize
            doğal bir avantaj sağlıyor.
          </p>
          <p>
            Temel işimiz; müşterilerimizin ihtiyaçlarını tam olarak anlamak, bu ihtiyaçları ekonomik biçimde çözmek ve
            dünya genelindeki kargo şirketlerinin stratejik taşımacılık ihtiyaçlarına destek olmaktır. Önceliğimiz,
            her türlü hava aracı kiralama talebini <strong>piyasa koşullarına uygun rekabetçi fiyatlarla</strong> ve
            <strong>en hızlı şekilde</strong> çözüme kavuşturmaktır.
          </p>
          <p>
            Yedi kıtada; Avrupa, BDT ülkeleri, Rusya, Afrika, Orta Doğu, Uzak Doğu ve ABD’deki yerel temsilcilerimizle
            birlikte, uçuş emniyetini öncelik olarak kabul eden ve <strong>ICAO ile IATA kurallarına uygun</strong>
            çözümler sunuyoruz.
          </p>
        </div>
      </div>
      <div class="story__media">
        <div class="story__img story__img--a" data-reveal-mask>
          <Image src={storyImage} alt="Gün ışığında business jet burnu ve motoru" widths={[480, 720, 960]} sizes="(min-width: 1024px) 34vw, 70vw" loading="lazy" />
        </div>
        <div class="story__img story__img--b" data-reveal-mask>
          <Image src={storyImage2} alt="Pist yaklaşmasında kokpitten görünüm" widths={[360, 540, 720]} sizes="(min-width: 1024px) 22vw, 50vw" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- Mission / vision / values -->
  <section class="section surface-white mvv" aria-labelledby="mvv-title">
    <div class="container">
      <h2 class="visually-hidden" id="mvv-title">Misyon, vizyon ve değerler</h2>
      <div class="mvv__grid">
        <article class="mvv__item" data-reveal>
          <p class="eyebrow">Misyonumuz</p>
          <p class="mvv__statement">
            Her türlü hava aracı kiralama talebini, rekabetçi fiyatlarla ve <em>en hızlı şekilde</em> çözüme
            kavuşturmak.
          </p>
        </article>
        <article class="mvv__item" data-reveal style="--reveal-delay:100">
          <p class="eyebrow">Vizyonumuz</p>
          <p class="mvv__statement">
            Kritik bir operasyon söz konusu olduğunda, <em>ilk aranan</em> charter çözüm ortağı olmak.
          </p>
        </article>
      </div>

      <div class="values">
        <p class="eyebrow values__label" data-reveal>Değerlerimiz</p>
        <ol class="values__list" role="list">
          {
            values.map((v, i) => (
              <li data-reveal style={`--reveal-delay:${i * 70}`}>
                <span>0{i + 1}</span>
                <h3 class="h4">{v.title}</h3>
                <p>{v.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Network -->
  <section class="section surface-ink network" aria-labelledby="network-title">
    <div class="container">
      <SectionHeader
        id="network-title"
        eyebrow="Global ağ"
        title="Asya ile Avrupa’nın kesişiminden"
        accent="yedi bölgeye."
        lead="Yerel temsilcilerimiz; uçuşun gerçekleşeceği bölgenin kurallarını, havalimanlarını ve koşullarını bilen bir ağ olarak İstanbul’daki ekibimizle birlikte çalışır."
        layout="split"
      />
      <WorldMap />
      <ul class="network__regions" role="list">
        {site.regions.map((r, i) => <li><span>0{i + 1}</span>{r}</li>)}
      </ul>
    </div>
  </section>

  <!-- How we work -->
  <section class="section" aria-labelledby="how-title">
    <div class="container">
      <SectionHeader
        id="how-title"
        eyebrow="Çalışma biçimimiz"
        title="Baştan sona"
        accent="güvenilir bir süreç."
        lead="Her talep, aynı disiplinle ele alınır. Böylece operasyonun her aşamasında neyin, ne zaman ve kim tarafından yapılacağı bellidir."
        layout="split"
      />
      <ProcessSteps steps={defaultProcess} />
    </div>
  </section>

  <!-- Standards -->
  <section class="section surface-paper-2" aria-labelledby="std-title">
    <div class="container std">
      <div data-reveal>
        <p class="eyebrow">Standartlar</p>
        <h2 class="h2 std__title" id="std-title">Kurallar, <em>güvenin temelidir.</em></h2>
      </div>
      <dl class="std__list">
        {
          standards.map((s, i) => (
            <div data-reveal style={`--reveal-delay:${i * 70}`}>
              <dt>{s.code}</dt>
              <dd>{s.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <CtaBand
    eyebrow="Birlikte çalışalım"
    title="Siz de benzersiz bir"
    accent="operasyon deneyimi için."
    image={ctaImage}
  />
</BaseLayout>

<style>
  /* Story */
  .story__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem clamp(3rem, 7vw, 8rem);
    align-items: center;
  }

  .story__prose p {
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .story__media {
    position: relative;
    padding-bottom: 18%;
  }

  .story__img {
    overflow: hidden;
    background: var(--ink-800);
  }

  .story__img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story__img--a {
    width: 82%;
    aspect-ratio: 4 / 5;
  }

  .story__img--b {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 48%;
    aspect-ratio: 1;
    border: 8px solid var(--paper);
  }

  @media (max-width: 1023px) {
    .story__grid {
      grid-template-columns: 1fr;
    }

    .story__img--a {
      aspect-ratio: 4 / 3;
    }
  }

  /* Mission / vision / values */
  .mvv__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 3rem clamp(3rem, 7vw, 8rem);
  }

  .mvv__statement {
    margin-top: 1.5rem;
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.6rem);
    line-height: 1.18;
    letter-spacing: -0.022em;
  }

  .mvv__statement em {
    font-weight: 300;
    color: var(--brand-600);
  }

  .values {
    margin-top: clamp(4rem, 3rem + 4vw, 7rem);
  }

  .values__label {
    margin-bottom: 2rem;
  }

  .values__list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 2rem;
  }

  .values__list li {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--text);
  }

  .values__list span {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--brand);
  }

  .values__list p {
    font-size: var(--fs-small);
    color: var(--text-2);
  }

  @media (max-width: 1023px) {
    .values__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 719px) {
    .mvv__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 479px) {
    .values__list {
      grid-template-columns: 1fr;
    }
  }

  /* Network */
  .network {
    overflow: hidden;
  }

  .network__regions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.25rem;
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line-inv-strong);
    font-size: 1.0625rem;
  }

  .network__regions span {
    margin-right: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--brand-300);
  }

  /* Standards */
  .std {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 3rem clamp(3rem, 7vw, 8rem);
  }

  .std__title {
    margin-top: 1.25rem;
  }

  .std__title em {
    display: block;
    font-weight: 300;
    color: var(--brand-600);
  }

  .std__list > div {
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 1.5rem;
    padding: 1.4rem 0;
    border-top: 1px solid var(--line);
  }

  .std__list > div:last-child {
    border-bottom: 1px solid var(--line);
  }

  .std__list dt {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    letter-spacing: -0.01em;
    color: var(--brand-600);
  }

  .std__list dd {
    color: var(--text-2);
    padding-top: 0.2rem;
  }

  @media (max-width: 899px) {
    .std {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 479px) {
    .std__list > div {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
