---
import { Picture } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import { getServices } from '@/data/services';
import { pathTo } from '@/i18n/config';
import image from '@/assets/images/contrail-ocean.jpg';

// GitHub Pages serves a single 404 page for every locale: English first, with a Turkish way back.
const popular = getServices('en').slice(0, 4);
---

<BaseLayout title="Page not found" description="The page you are looking for could not be found." noindex>
  <section class="nf" aria-labelledby="nf-title">
    <div class="nf__media" aria-hidden="true">
      <Picture src={image} alt="" formats={['avif', 'webp']} widths={[960, 1600, 2400]} sizes="100vw" loading="eager" />
    </div>
    <div class="container nf__inner">
      <p class="nf__code">404 · Route not found</p>
      <h1 class="display nf__title" id="nf-title">This route <em>isn’t on the map.</em></h1>
      <p class="nf__lead">
        The page you are looking for may have been moved or removed. Head back to the home page or explore our services.
      </p>
      <div class="btn-row">
        <a href={pathTo('en', 'home')} class="btn btn--light">Back to Home <Icon name="arrow-right" /></a>
        <a href={pathTo('en', 'services')} class="btn btn--ghost-light">Explore Our Services</a>
      </div>
      <p class="nf__alt" lang="tr">
        Aradığınız sayfa bulunamadı. <a href={pathTo('tr', 'home')}>Türkçe ana sayfaya dönün</a>
      </p>
      <ul class="nf__links" role="list">
        {popular.map((s) => <li><a href={s.href}>{s.navTitle}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 100svh;
    background: var(--ink-950);
    color: var(--text-inv);
    isolation: isolate;
  }

  .nf__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    opacity: 0.55;
  }

  .nf__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, var(--ink-950) 25%, rgba(5, 9, 15, 0.4) 70%, rgba(5, 9, 15, 0.2));
  }

  .nf__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .nf__inner {
    padding-block: calc(var(--header-h) + 4rem) 5rem;
  }

  .nf__code {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand-300);
  }

  .nf__title {
    margin: 1.5rem 0;
    max-width: 14ch;
  }

  .nf__title em {
    display: block;
    font-weight: 300;
    color: var(--brand-200);
  }

  .nf__lead {
    max-width: 50ch;
    margin-bottom: 2.5rem;
    font-size: var(--fs-lead);
    color: var(--text-inv-2);
  }

  .nf__alt {
    margin-top: 1.75rem;
    font-size: var(--fs-small);
    color: var(--text-inv-2);
  }

  .nf__alt a {
    color: var(--brand-300);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .nf__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    margin-top: 3.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line-inv);
    font-size: var(--fs-small);
  }

  .nf__links a {
    color: var(--text-inv-2);
    transition: color 0.25s;
  }

  .nf__links a:hover {
    color: var(--white);
  }
</style>
